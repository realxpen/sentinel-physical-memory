# Server-side only. Never expose these keys in VITE_* variables.
NEBIUS_API_KEY=
NEBIUS_TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
NEBIUS_PERCEPTION_MODEL=openbmb/MiniCPM-V-4_5
# Optional. /api/scan defaults to a bounded provider attempt budget and clamps configured values.
NEBIUS_PERCEPTION_TIMEOUT_MS=70000
NEBIUS_NEMOTRON_REASONING_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Optional dedicated visual verification model. If blank, verification uses NEBIUS_PERCEPTION_MODEL.
NEBIUS_VERIFICATION_MODEL=

# Phase 3 persistent environmental memory (server-side only).
# Use the least-privilege Neon sentinel_app role for deployed runtime access.
DATABASE_URL=
# Optional override: auto | websocket | http.
# Local defaults to auto (WebSocket preferred, HTTP fallback); deployed Vercel defaults to http.
SENTINEL_NEON_TRANSPORT=

# Optional: reject browser requests whose normalized Origin does not match this value.
# A trailing slash is ignored. Example: https://sentinel-physical-memory.vercel.app
SENTINEL_ALLOWED_ORIGIN=
