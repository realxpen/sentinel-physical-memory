# Server-side only. Never expose these keys in VITE_* variables.
NEBIUS_API_KEY=
NEBIUS_TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_NEMOTRON_MODEL=nvidia/nemotron-3-nano-omni
NEBIUS_NEMOTRON_REASONING_MODEL=

# Phase 3 persistent environmental memory (server-side only).
# Use the least-privilege Neon sentinel_app role for deployed runtime access.
DATABASE_URL=

# Optional: reject browser requests whose Origin does not match this value.
SENTINEL_ALLOWED_ORIGIN=
