# Server-side only. Never expose these keys in VITE_* variables.
NEBIUS_API_KEY=
NEBIUS_TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
NEBIUS_PERCEPTION_MODEL=openbmb/MiniCPM-V-4_5
# Optional. Multi-frame perception defaults to 120000ms and is clamped to 30000–180000ms.
NEBIUS_PERCEPTION_TIMEOUT_MS=120000
NEBIUS_NEMOTRON_REASONING_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Phase 3 persistent environmental memory (server-side only).
# Use the least-privilege Neon sentinel_app role for deployed runtime access.
DATABASE_URL=
# Optional override. Local defaults to websocket; deployed Vercel defaults to http.
SENTINEL_NEON_TRANSPORT=

# Optional: reject browser requests whose Origin does not match this value.
SENTINEL_ALLOWED_ORIGIN=
