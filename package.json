{
  "name": "sentinel-physical-memory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:local": "bash ./scripts/dev-local.sh",
    "check:neon": "node ./scripts/check-neon.mjs",
    "check:nebius": "node ./scripts/check-nebius.mjs",
    "check:phase4-poor-inputs": "node --experimental-strip-types ./scripts/check-phase4-poor-inputs.mjs",
    "check:phase4-evidence-refs": "node --experimental-strip-types ./scripts/check-phase4-evidence-references.mjs",
    "check:provider-boundary": "node --experimental-strip-types ./scripts/check-provider-boundary.mjs",
    "check:perception-retry": "node --experimental-strip-types ./scripts/check-perception-retry.mjs",
    "check:condition-audit": "node --experimental-strip-types ./scripts/check-condition-audit.mjs",
    "check:phase5-conditions": "node --experimental-strip-types ./scripts/check-phase5-condition-model.mjs",
    "check:condition-derivation": "node ./scripts/check-condition-derivation.mjs",
    "check:diff-position": "node ./scripts/check-diff-position.mjs",
    "check:object-identity": "node ./scripts/check-object-identity.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:phase6-history": "node --experimental-strip-types ./scripts/check-phase6-history.mjs",
    "check:phase7-diff": "node --experimental-strip-types ./scripts/check-phase7-diff-v2.mjs",
    "check:photo-observation": "node --experimental-strip-types ./scripts/check-photo-observation.mjs",
    "check:state-concurrency": "node --experimental-strip-types ./scripts/check-state-concurrency.mjs",
    "check:phase8-presentation": "node --experimental-strip-types ./scripts/check-phase8-change-presentation.mjs",
    "check:temporal-photo-diff": "node --experimental-strip-types ./scripts/check-temporal-photo-diff.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "latest",
    "@vitejs/plugin-react": "latest",
    "jsonrepair": "^3.15.0",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
